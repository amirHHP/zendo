# ===================================================
# Zendo GTD Environment Variables Template
# ===================================================

# Database: PostgreSQL (Neon / Supabase / Vercel Postgres / Local)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/zendo?sslmode=require"

# NextAuth configuration
NEXTAUTH_URL="https://theminiceo.ir/zendo"
NEXTAUTH_SECRET="generate_a_random_32_character_string_here"

# Base path for deployment (leave empty for root domain, or '/zendo' for theminiceo.ir/zendo)
NEXT_PUBLIC_BASE_PATH=""

# Central Gemini API Key (Server fallback if user has not set their own)
GEMINI_API_KEY=""

# ZarinPal Payment Gateway
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX="false"

# Pro Plan Pricing in Tomans
PRO_MONTHLY_PRICE="49000"
PRO_YEARLY_PRICE="390000"
